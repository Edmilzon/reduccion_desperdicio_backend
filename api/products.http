# ============================================
# PRODUCTS - Productos con Categorías
# ============================================
# Este módulo maneja la gestión de productos.
# Los productos pertenecen a un comercio específico y pueden tener categoría.
# Base URL: http://localhost:3000

@baseURL = http://localhost:3000
@token = your_jwt_token_here
@commerceId = uuid-del-comercio
@productId = uuid-del-producto
@categoryId = uuid-de-categoria
@categorySlug = panaderia

# ============================================
# CATEGORÍAS
# ============================================

###
# Listar todas las categorías
GET {{baseURL}}/products/categories

###
# Obtener categoría por ID
GET {{baseURL}}/products/categories/{{categoryId}}

###
# Obtener categoría por slug
GET {{baseURL}}/products/categories/slug/{{categorySlug}}

###
# Obtener productos por categoría
GET {{baseURL}}/products/category/{{categoryId}}

###
# Obtener productos por categoría filtrados por comercio
GET {{baseURL}}/products/category/{{categoryId}}?commerceId={{commerceId}}

# ============================================
# PRODUCTOS
# ============================================

###
# Listar todos los productos
GET {{baseURL}}/products

###
# Listar productos filtrados por categoría
GET {{baseURL}}/products?categoryId={{categoryId}}

###
# Listar productos filtrados por comercio
GET {{baseURL}}/products?commerceId={{commerceId}}

###
# Crear producto con categoría (requiere autenticación)
POST {{baseURL}}/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Pan Integral",
  "description": "Pan integral fresco",
  "originalPrice": 5.00,
  "price": 3.50,
  "quantity": 20,
  "expiryDate": "2024-12-31",
  "commerceId": "uuid-del-comercio",
  "categoryId": "uuid-de-categoria"
}

###
# Obtener productos por comercio
GET {{baseURL}}/products/commerce/{{commerceId}}

###
# Obtener productos por comercio con filtro de estado
GET {{baseURL}}/products/commerce/{{commerceId}}?status=active

###
# Obtener productos por comercio filtrados por categoría
GET {{baseURL}}/products/commerce/{{commerceId}}?categoryId={{categoryId}}

###
# Obtener producto por ID
GET {{baseURL}}/products/{{productId}}

###
# Actualizar producto (requiere autenticación)
PATCH {{baseURL}}/products/{{productId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Pan Integral Actualizado",
  "description": "Nueva descripción",
  "originalPrice": 6.00,
  "price": 4.00,
  "quantity": 15,
  "expiryDate": "2025-01-15",
  "categoryId": "uuid-nueva-categoria"
}

###
# Eliminar producto (requiere autenticación)
DELETE {{baseURL}}/products/{{productId}}
Authorization: Bearer {{token}}