# ============================================
# PRODUCTS - Productos
# ============================================
# Este módulo maneja la gestión de productos.
# Los productos pertencen a un comercio específico.
# Base URL: http://localhost:3000

@baseURL = http://localhost:3000
@token = your_jwt_token_here
@commerceId = uuid-del-comercio
@productId = uuid-del-producto

# ============================================
# POST /products
# ----------------------------------
# Descripción: Crea un nuevo producto para un comercio.
# Autenticación: REQUERIDA - Bearer token.
# Body (JSON):
#   {
#     "name": "Pan Integral",      // OBLIGATORIO - Nombre del producto
#     "description": "Pan fresco",   // OPCIONAL
#     "originalPrice": 5.00,    // OBLIGATORIO - Precio original
#     "price": 3.50,          // OBLIGATORIO - Precio de oferta
#     "quantity": 20,          // OBLIGATORIO - Cantidad disponible
#     "expiryDate": "2024-12-31", // OPCIONAL - Fecha vencimiento
#     "commerceId": "uuid"     // OBLIGATORIO - ID del comercio
#   }
# Headers:
#   Authorization: Bearer <token>
# Respuesta exitosa (201):
#   {
#     "id": "uuid-generated",
#     "name": "Pan Integral",
#     "description": "Pan fresco",
#     "originalPrice": 5.00,
#     "price": 3.50,
#     "quantity": 20,
#     "expiryDate": "2024-12-31",
#     "commerceId": "uuid",
#     "status": "available",
#     "createdAt": "..."
#   }
# Errores comunes:
#   - 401 Unauthorized: Sin token
#   - 400 Bad Request: Datos inválidos
#   - 404 Not Found: Comercio no existe

###
# Crear producto (requiere autenticación)
POST {{baseURL}}/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Pan Integral",
  "description": "Pan integral fresco",
  "originalPrice": 5.00,
  "price": 3.50,
  "quantity": 20,
  "expiryDate": "2024-12-31",
  "commerceId": "uuid-del-comercio"
}

# ============================================
# GET /products
# ----------------------------------
# Descripción: Lista todos los productos del sistema.
# Autenticación: No requerida (pública).
# Respuesta exitosa (200):
#   [
#     { "id": "...", "name": "Producto 1", ... },
#     { "id": "...", "name": "Producto 2", ... }
#   ]

###
# Listar todos los productos
GET {{baseURL}}/products

# ============================================
# GET /products/:id
# ----------------------------------
# Descripción: Obtiene un producto específico por su ID.
# Autenticación: No requerida (pública).
# Params:
#   :id - UUID del producto (reemplaza {{productId}})
# Respuesta exitosa (200):
#   {
#     "id": "uuid-generated",
#     "name": "Pan Integral",
#     "originalPrice": 5.00,
#     "price": 3.50,
#     "quantity": 20,
#     "status": "available"
#   }
# Errores comunes:
#   - 404 Not Found: Producto no existe

###
# Obtener producto por ID
GET {{baseURL}}/products/{{productId}}

# ============================================
# GET /products/commerce/:commerceId
# ----------------------------------
# Descripción: Lista productos de un comercio específico.
#              Debe ir ANTES de GET /:id para evitar conflicto de rutas.
# Autenticación: No requerida (pública).
# Params:
#   :commerceId - UUID del comercio
# Query params (opcional):
#   status=available  - Filtra solo productos disponibles
# Respuesta exitosa (200):
#   [
#     { "id": "...", "name": "Producto 1", "status": "available" },
#     { "id": "...", "name": "Producto 2", "status": "sold-out" }
#   ]

###
# Obtener productos por comercio
GET {{baseURL}}/products/commerce/{{commerceId}}

###
# Obtener productos por comercio con filtro de estado
GET {{baseURL}}/products/commerce/{{commerceId}}?status=available

# ============================================
# PATCH /products/:id
# ----------------------------------
# Descripción: Actualiza los datos de un producto.
# Autenticación: REQUERIDA - Bearer token.
#              El usuario debe ser owner del comercio.
# Body (JSON) - Solo incluye campos a actualizar:
#   {
#     "name": "Nuevo Nombre",    // OPCIONAL
#     "description": "Nueva desc", // OPCIONAL
#     "originalPrice": 6.00,  // OPCIONAL
#     "price": 4.00,        // OPCIONAL
#     "quantity": 15,        // OPCIONAL
#     "expiryDate": "2025-01-15" // OPCIONAL
#   }
# Params:
#   :id - UUID del producto
# Respuesta exitosa (200):
#   { "id": "...", "updatedAt": "..." }
# Errores comunes:
#   - 401 Unauthorized: Sin token
#   - 403 Forbidden: No eres owner del comercio

###
# Actualizar producto (requiere autenticación)
PATCH {{baseURL}}/products/{{productId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Pan Integral Actualizado",
  "description": "Nueva descripción",
  "originalPrice": 6.00,
  "price": 4.00,
  "quantity": 15,
  "expiryDate": "2025-01-15"
}

# ============================================
# DELETE /products/:id
# ----------------------------------
# Descripción: Elimina un producto.
# Autenticación: REQUERIDA - Bearer token.
#              El usuario debe ser owner del comercio.
# Params:
#   :id - UUID del producto
# Respuesta exitosa (200):
#   { "message": "Producto eliminado" }
# Errores comunes:
#   - 401 Unauthorized: Sin token
#   - 403 Forbidden: No eres owner

###
# Eliminar producto (requiere autenticación)
DELETE {{baseURL}}/products/{{productId}}
Authorization: Bearer {{token}}